new file mode 100644
index 00000000..5bfec37a
--- /dev/null
+++ b/cmd/nanolathe/hero_capture_scene.go
@@ -0,0 +1,127 @@
+package main
+
+// Local website composition only. Original definitions, COB scripts, placement
+// checks, normal factory/mobile construction and ordinary combat still produce
+// every visible unit, building and effect through the production film route.
+import (
+	"fmt"
+	"os"
+
+	"github.com/nanolathe-gg/nanolathe/internal/construction"
+	"github.com/nanolathe-gg/nanolathe/internal/features"
+	"github.com/nanolathe-gg/nanolathe/internal/session"
+	"github.com/nanolathe-gg/nanolathe/internal/sim/numeric"
+	"github.com/nanolathe-gg/nanolathe/internal/units"
+)
+
+func stageHomepageBase(s *session.Session, x, z int32, create func(string, int, int32, int32, bool) *units.Unit) error {
+	type placement struct {
+		name   string
+		owner  int
+		dx, dz int32
+	}
+	// The base sits behind the ARM line in screen depth rather than a distant
+	// horizontal rank. The hero's narrow viewport can therefore show its actual
+	// production buildings alongside combat without crowding model silhouettes.
+	placements := []placement{
+		{"armlab", 0, 170, -80},
+		{"armsolar", 0, 25, -150},
+		{"armrad", 0, 245, -145},
+		{"armllt", 0, 180, 160},
+		{"armcom", 0, 235, 80},
+		{"armbull", 0, 100, 5},
+		{"armstump", 0, 10, -50},
+		{"armflash", 0, -5, 100},
+		{"armzeus", 0, 80, 95},
+		{"corraid", 1, -145, -65},
+		{"corlevlr", 1, -155, 45},
+		{"correap", 1, -180, 150},
+		{"corstorm", 1, -240, 15},
+	}
+	fixed := func(v int32) numeric.Fixed { return numeric.Fixed(int64(v) << 16) }
+	var staged []*units.Unit
+	for _, p := range placements {
+		def, ok := s.Catalog.Unit(p.name)
+		if !ok {
+			return fmt.Errorf("homepage composition: no definition for %s", p.name)
+		}
+		var u *units.Unit
+		offsets := [][2]int32{{0, 0}}
+		for _, radius := range []int32{16, 32, 48, 64, 80} {
+			offsets = append(offsets, [2]int32{radius, 0}, [2]int32{-radius, 0}, [2]int32{0, radius}, [2]int32{0, -radius}, [2]int32{radius, radius}, [2]int32{-radius, radius}, [2]int32{radius, -radius}, [2]int32{-radius, -radius})
+		}
+		for _, offset := range offsets {
+			px, pz := x+p.dx+offset[0], z+p.dz+offset[1]
+			if !filmPlaceable(s, def, fixed(px), fixed(pz)) {
+				continue
+			}
+			crowded := false
+			for _, other := range staged {
+				padding := int32(32)
+				if def.BMCode == 0 && other.Def.BMCode == 0 {
+					padding = 16
+				}
+				marginX := (int32(def.FootprintX)+int32(other.Def.FootprintX))*8 + padding
+				marginZ := (int32(def.FootprintZ)+int32(other.Def.FootprintZ))*8 + padding
+				dx, dz := px-int32(other.X.Int()), pz-int32(other.Z.Int())
+				if dx < 0 {
+					dx = -dx
+				}
+				if dz < 0 {
+					dz = -dz
+				}
+				if dx < marginX && dz < marginZ {
+					crowded = true
+					break
+				}
+			}
+			if crowded {
+				continue
+			}
+			u = create(p.name, p.owner, px, pz, false)
+			if u != nil {
+				break
+			}
+		}
+		if u == nil {
+			return fmt.Errorf("homepage composition: no clear placement for %s near %d,%d", p.name, x+p.dx, z+p.dz)
+		}
+		// Prepare this fixture's small placement clearing through the feature
+		// lifecycle. Original surrounding foliage stays; indestructible map
+		// features (including deposits) are never removed. This is scene
+		// staging, not a claim about a game unit automatically clearing trees.
+		removed := 0
+		halfX, halfZ := int32(def.FootprintX)*8+16, int32(def.FootprintZ)*8+16
+		for cz := int32(u.Z.Int()-int64(halfZ)) / 16; cz <= int32(u.Z.Int()+int64(halfZ))/16; cz++ {
+			for cx := int32(u.X.Int()-int64(halfX)) / 16; cx <= int32(u.X.Int()+int64(halfX))/16; cx++ {
+				cell := s.World.PlotAt(cx, cz)
+				if cell == nil {
+					continue
+				}
+				feature, ok := s.World.FeatureDefAt(cell.Feature())
+				if !ok || feature == nil || feature.Indestructible {
+					continue
+				}
+				s.Features.RemoveFeatureAt(int(cx), int(cz), features.CauseBurnt)
+				s.Features.RemoveFeatureAt(int(cx), int(cz), features.CauseBurnt)
+				removed++
+			}
+		}
+		if removed > 0 {
+			fmt.Fprintf(os.Stderr, "nanolathe: hero: cleared %d destructible feature anchors around %s\n", removed, p.name)
+		}
+		staged = append(staged, u)
+		fmt.Fprintf(os.Stderr, "nanolathe: hero: placed %s owner=%d at %d,%d\n", p.name, p.owner, u.X.Int(), u.Z.Int())
+		if p.name == "armlab" {
+			if err := construction.QueueFactoryBuild(u, "armpw", 12, s.Catalog); err != nil {
+				return err
+			}
+		}
+	}
+	// One fighter follows a normal patrol leg; no invented altitude or pose.
+	if plane := create("armfig", 0, x+15, z-90, true); plane != nil {
+		filmOrder(s, plane, 9, fixed(x-160), fixed(z+100))
+		filmOrder(s, plane, 9, fixed(x+150), fixed(z-150))
+	}
+	return nil
+}
